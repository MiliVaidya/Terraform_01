# Local .terraform directories
/aws/.terraform
/azure/.terraform
/gcp/.terraform

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
**/*.tfvars
**/*.tfvars.json

# Ignore override files as they are usually used for local development
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore lock files
.terraform.lock.hcl

# Ignore provider binary files
**/providers/
**/registry.terraform.io/

# Ignore system files
.DS_Store
Thumbs.db

# Ignore IDE files
.idea/
.vscode/
*.swp
*.swo

# Ignore log files
*.log

# Ignore backup files
*.bak
*~

# Ignore sensitive files
*.pem
*.key
*.pub
id_rsa*
*.ppk

# Ignore environment files
.env
.env.*

# Ignore cloud provider specific files
**/aws/credentials
**/azure/credentials
**/gcp/credentials
**/aws/config
**/azure/config
**/gcp/config